# API credentials for asl-fluency external services.
#
# Setup:
#   cp example.env .env       # then fill in your key
#   .env is gitignored — NEVER commit it.
#
# config.py loads .env automatically (variables already set in the shell
# take precedence), so no source/export step is needed.

# xAI (Grok) — used by `asl-fluency ai-rate --backend grok`
# Get a key at https://console.x.ai
XAI_API_KEY=
